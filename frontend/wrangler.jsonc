{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadflow",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
  // Supply API_ORIGIN as a fixed HTTPS origin at deployment.
  // Supply INGRESS_SHARED_SECRET through wrangler secret, never frontend vars.
}
