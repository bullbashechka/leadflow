# Generate local credentials: python3 scripts/init_local_env.py
# Never commit real values.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Django encoded hash; configure with scripts/set_demo_password.py. Never put it in Vite.
CRM_DEMO_PASSWORD_HASH=
POSTGRES_DB=leadflow
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Runtime database deadlines. Use a separate profile for migrations.
DB_CONNECT_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=8000
DB_LOCK_TIMEOUT_MS=2000
# Optional; only needed for the bot profile. Keep it out of chat and Git.
BOT_TOKEN=
# Public Telegram link; safe for the browser bundle.
VITE_TELEGRAM_BOT_URL=
# Host ports only. Internal container ports remain fixed.
FRONTEND_PORT=5173
API_PORT=8000
