# Generate local credentials: python3 scripts/init_local_env.py
# Never commit real values.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=leadflow
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional; only needed for the bot profile. Keep it out of chat and Git.
BOT_TOKEN=
# Host ports only. Internal container ports remain fixed.
FRONTEND_PORT=5173
API_PORT=8000
